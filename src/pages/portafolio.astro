<!-- portafolio.astro -->
---
import Layout from '@/layouts/MainLayout.astro';
import PortfolioSection, { PROJECTS_STATIC } from '@/components/portafolio/Portafoliosection.jsx';
import { translations } from '@/i18n/translations';
import { portfolioSchema, SITE_URL } from '@/data/seo';

const copy = translations.es.portfolio.projects;
const portfolio = portfolioSchema(
  PROJECTS_STATIC.map((p) => ({
    name: p.title,
    description: copy[p.id]?.desc ?? copy[p.id]?.tagline ?? p.title,
    url: p.link,
    // Solo imágenes propias: las de stock no representan el proyecto y no
    // aportan nada como dato estructurado.
    image: p.image?.startsWith('/') ? `${SITE_URL}${p.image}` : undefined,
  })),
);
---

<Layout
  title="Portafolio: Proyectos de Apps, Web e IA | Geck Codex"
  description="Proyectos reales de Geck Codex: apps móviles, sistemas de visión artificial, plataformas web, e-commerce y landings de alta conversión para clientes en México."
  canonical={`${SITE_URL}/portafolio/`}
  breadcrumbs={[{ name: 'Portafolio', url: `${SITE_URL}/portafolio/` }]}
  schema={[portfolio]}
>
  <PortfolioSection client:visible />
</Layout>
