---
import { ClientRouter } from 'astro:transitions';
import Footer from '@/components/Footer.jsx';
import Navbar from '@/components/Navbar.jsx';
import Analytics from '@/components/Analytics.astro';
import '@/styles/global.css';

import { ORGANIZATION_SCHEMA, WEBSITE_SCHEMA, breadcrumbSchema, BUSINESS, SITE_URL } from '@/data/seo';
import { LOCALE_META, alternatesFor, DEFAULT_LOCALE } from '@/i18n/routes';
import type { Locale, PageKey } from '@/i18n/routes';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  /** Idioma de ESTA página. Determina <html lang>, og:locale y el hreflang propio. */
  lang?: Locale;
  /**
   * Página del mapa de rutas. Emite el hreflang recíproco hacia sus otras
   * variantes y viaja al nav y al pie para que sus enlaces de idioma lleven a
   * ESTA misma página en los otros dos, no a la portada.
   */
  pageKey?: PageKey;
  /** Migas de pan de la página → genera BreadcrumbList. Omitir en la home. */
  breadcrumbs?: { name: string; url: string }[];
  /** JSON-LD adicional específico de la página (Service, FAQPage, ItemList…). */
  schema?: Record<string, unknown>[];
  /**
   * Título y descripción SOLO para la tarjeta que se ve al compartir el enlace
   * (WhatsApp, LinkedIn, Facebook). Si se omiten, se usan los de buscador.
   */
  ogTitle?: string;
  ogDescription?: string;
}

const {
  title = 'Geck Codex | Desarrollo Web, Apps y AI desde México',
  description = 'Empresa de desarrollo web, apps móviles e inteligencia artificial en Parral, Chihuahua. Jóvenes mexicanos revolucionando la tecnología digital.',
  image = 'https://geckcodex.com/assets/image/og-image.jpg',
  canonical = Astro.url.href,
  noindex = false,
  type = 'website',
  breadcrumbs = [],
  schema = [],
  ogTitle,
  ogDescription,
  lang = DEFAULT_LOCALE,
  pageKey,
} = Astro.props;

// ── Idioma y variantes ──────────────────────────────────────────────────
// El hreflang solo se emite si la página existe en varios idiomas. Declararlo
// apuntando a URLs que no existen es peor que no declararlo: Google descarta
// el grupo entero cuando los enlaces no son recíprocos.
const localeMeta = LOCALE_META[lang];
const alternates = pageKey ? alternatesFor(pageKey, SITE_URL) : [];
const alternateOgLocales = pageKey
  ? Object.entries(LOCALE_META)
      .filter(([code]) => code !== lang)
      .map(([, meta]) => meta.ogLocale)
  : [];

const siteName = 'Geck Codex';
const twitterHandle = '@geckcodex';

// El título de buscador y el de la tarjeta social cumplen funciones distintas.
// En Google conviene "Servicios… | Geck Codex" porque compite entre diez
// resultados; en WhatsApp la marca y el dominio ya se muestran aparte, así que
// repetirlos gasta el espacio visible. Por eso se recorta el sufijo de marca.
const socialTitle = ogTitle ?? title.replace(/\s*\|\s*Geck Codex\s*$/, '');
const socialDescription = ogDescription ?? description;

// ── Grafo JSON-LD: entidad de negocio + sitio + migas + schema de página ──
// Se emite como un solo @graph: los motores (y los buscadores con IA) resuelven
// mejor las relaciones entre entidades cuando comparten un único bloque.
const jsonLdGraph = [
  ORGANIZATION_SCHEMA,
  WEBSITE_SCHEMA,
  ...(breadcrumbs.length ? [breadcrumbSchema(breadcrumbs)] : []),
  ...schema,
];
---

<html lang={localeMeta.htmlLang}>
  <head>
    <meta charset="UTF-8" />

    <!-- ═══════════════════════════════════════
         TEMA — no-flash (corre ANTES del CSS)
         Lee localStorage; si no hay, usa prefers-color-scheme.
    ═══════════════════════════════════════ -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('geck-theme');
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>

    <meta name="google-site-verification" content="zQdCDQH6eJc4lniZPIcpINIApecX4D-fwU3IgfSA2YQ" />
    <meta name="msvalidate.01" content="1EC247476441BECB05ECD4933785888A" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- ═══════════════════════════════════════
         NAVEGACIÓN — ClientRouter sin animación de transición.
         Mantiene el SPA/prefetch (cambio de página rápido) pero el swap
         es instantáneo: sin wipe ni fade entre páginas.
    ═══════════════════════════════════════ -->
    <ClientRouter />
    <style is:global>
      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation: none;
      }
    </style>
    <script>
      // Durante la navegación, el reset de scroll debe ser INSTANTÁNEO.
      // Sin esto, `scroll-behavior: smooth` anima el regreso al tope cuando
      // vienes de una página scrolleada (p. ej. Contacto → Home) y la
      // transición se siente "eterna".
      document.addEventListener('astro:before-swap', () => {
        document.documentElement.style.scrollBehavior = 'auto';
      });

      // Reaplica el tema tras cada swap (el script no-flash solo corre en carga completa).
      document.addEventListener('astro:after-swap', () => {
        // Restaura el smooth-scroll una vez asentada la nueva página.
        requestAnimationFrame(() => {
          document.documentElement.style.scrollBehavior = '';
        });
        try {
          let t = localStorage.getItem('geck-theme');
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      });
    </script>

    <!-- ═══════════════════════════════════════
         TIPOGRAFÍA — Space Grotesk (títulos) + Inter (cuerpo)
    ═══════════════════════════════════════ -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Fuente no-bloqueante: se carga sin frenar el primer render (display=swap
        muestra texto al instante con la fuente de sistema y la cambia al cargar). */}
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      />
    </noscript>

    <!-- ═══════════════════════════════════════
         BÁSICO SEO
    ═══════════════════════════════════════ -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- ═══════════════════════════════════════
         HREFLANG — variantes de idioma de esta misma página.
         Recíproco: cada variante lista a todas, incluida a sí misma.
         x-default apunta al español, el mercado principal.
    ═══════════════════════════════════════ -->
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />}

    <!-- ═══════════════════════════════════════
         OPEN GRAPH (Facebook, WhatsApp, LinkedIn)
    ═══════════════════════════════════════ -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:image" content={image} />
    <meta property="og:image:secure_url" content={image} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Geck Codex — software que hace crecer tu negocio: desarrollo web, apps móviles e inteligencia artificial en Parral, Chihuahua" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={localeMeta.ogLocale} />
    {alternateOgLocales.map((l) => <meta property="og:locale:alternate" content={l} />)}

    <!-- ═══════════════════════════════════════
         TWITTER CARD
    ═══════════════════════════════════════ -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={twitterHandle} />
    <meta name="twitter:creator" content={twitterHandle} />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content="Geck Codex — software que hace crecer tu negocio: desarrollo web, apps móviles e inteligencia artificial en Parral, Chihuahua" />

    <!-- ═══════════════════════════════════════
         FAVICON Y ICONOS
         Usar los PNG recortados (32/192/512) en vez del logo de 261 KB.
    ═══════════════════════════════════════ -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/image/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/image/favicon-192x192.png" />
    <link rel="apple-touch-icon" href="/assets/image/favicon-192x192.png" />
    <meta name="theme-color" content="#0B1D33" />

    <!-- ═══════════════════════════════════════
         GEO — señales de ubicación para búsqueda local
    ═══════════════════════════════════════ -->
    <meta name="geo.region" content={BUSINESS.regionCode} />
    <meta name="geo.placename" content="Hidalgo del Parral, Chihuahua" />
    <meta name="geo.position" content={`${BUSINESS.latitude};${BUSINESS.longitude}`} />
    <meta name="ICBM" content={`${BUSINESS.latitude}, ${BUSINESS.longitude}`} />
    <meta name="author" content={siteName} />
    <meta name="publisher" content={siteName} />

    <!-- ═══════════════════════════════════════
         SCHEMA.ORG — grafo único de entidades
         Organization/ProfessionalService + WebSite + migas + schema de página
    ═══════════════════════════════════════ -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': jsonLdGraph })}
    />

    <!-- ═══════════════════════════════════════
         PERFORMANCE
    ═══════════════════════════════════════ -->
    <link rel="dns-prefetch" href="https://cdn.simpleicons.org" />

    <!-- ═══════════════════════════════════════
         MEDICIÓN — GA4 + Google Ads (solo si hay IDs en .env)
    ═══════════════════════════════════════ -->
    <Analytics />
  </head>
  <body>
    <!-- ═══════════════════════════════════════
         PRELOADER — carga inicial + transición de carga entre páginas.
         transition:persist mantiene el MISMO nodo entre navegaciones (no se
         recrea ni parpadea); el script lo muestra/oculta en cada cambio.
    ═══════════════════════════════════════ -->
    <div id="gc-preloader" class="gc-preloader" aria-hidden="true" transition:persist>
      <div class="gc-preloader__inner">
        <img src="/assets/image/logo.png" alt="" class="gc-preloader__logo" width="72" height="72" />
        <span class="gc-preloader__bar"><span class="gc-preloader__bar-fill"></span></span>
      </div>
    </div>
    <style is:global>
      .gc-preloader {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--background);
        transition: opacity 0.55s ease;
      }
      .gc-preloader.is-done { opacity: 0; pointer-events: none; }
      .gc-preloader__inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 22px;
      }
      .gc-preloader__logo {
        width: 72px;
        height: 72px;
        object-fit: contain;
        animation: gc-pl-pulse 1.6s ease-in-out infinite;
      }
      @keyframes gc-pl-pulse {
        0%, 100% { opacity: 0.5; transform: scale(0.95); }
        50%      { opacity: 1;   transform: scale(1); }
      }
      .gc-preloader__bar {
        width: 140px;
        height: 2px;
        border-radius: 2px;
        background: color-mix(in srgb, var(--accent) 20%, transparent);
        overflow: hidden;
      }
      .gc-preloader__bar-fill {
        display: block;
        height: 100%;
        width: 40%;
        border-radius: 2px;
        background: var(--accent);
        animation: gc-pl-slide 1.1s ease-in-out infinite;
      }
      @keyframes gc-pl-slide {
        0%   { transform: translateX(-120%); }
        100% { transform: translateX(320%); }
      }
      @media (prefers-reduced-motion: reduce) {
        .gc-preloader__logo,
        .gc-preloader__bar-fill { animation: none; }
        .gc-preloader { transition: none; }
      }
    </style>
    <script is:inline>
      // is:inline → corre durante el parseo y sus listeners sobre `document`
      // persisten entre navegaciones SPA (el preloader usa transition:persist,
      // así que es siempre el MISMO nodo).
      (function () {
        function pl() { return document.getElementById('gc-preloader'); }
        function show() { var el = pl(); if (el) el.classList.remove('is-done'); }
        function hide() { var el = pl(); if (el) el.classList.add('is-done'); }

        // ── Carga inicial: visible por defecto; ocultar cuando el DOM está listo
        //    (no esperamos a videos/imágenes pesadas, que cargan en 2.º plano).
        if (document.readyState !== 'loading') hide();
        else document.addEventListener('DOMContentLoaded', hide, { once: true });
        setTimeout(hide, 1500); // red de seguridad

        // ── Transición de carga entre páginas:
        //    mostrar al iniciar la navegación, ocultar cuando la nueva ya cargó.
        document.addEventListener('astro:before-preparation', show);
        document.addEventListener('astro:after-swap', function () {
          // La nueva página ya está en el DOM; breve pausa para que se vea la
          // transición de carga y se monte el contenido, luego revelar.
          requestAnimationFrame(function () { setTimeout(hide, 350); });
        });
      })();
    </script>

    <Navbar client:load lang={lang} pageKey={pageKey} />
    
    <main>
      <slot />
    </main>
    
    {/* `pageKey` viaja al pie para que los enlaces de idioma apunten a ESTA
        misma página en los otros dos, igual que el hreflang del head. Sin él
        mandarían a la portada y el visitante perdería dónde estaba. */}
    <Footer client:visible lang={lang} pageKey={pageKey} />
  </body>
</html>