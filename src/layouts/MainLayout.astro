---
import { ClientRouter } from 'astro:transitions';
import Footer from '@/components/Footer.jsx';
import Navbar from '@/components/Navbar.jsx';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
}

const {
  title = 'Geck Codex | Desarrollo Web, Apps y AI desde México',
  description = 'Empresa de desarrollo web, apps móviles e inteligencia artificial en Parral, Chihuahua. Jóvenes mexicanos revolucionando la tecnología digital.',
  image = 'https://geckcodex.com/assets/image/og-image.jpg',
  canonical = Astro.url.href,
  noindex = false,
  type = 'website',
} = Astro.props;

const siteName = 'Geck Codex';
const twitterHandle = '@geckcodex';
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <!-- ═══════════════════════════════════════
         TEMA — no-flash (corre ANTES del CSS)
         Lee localStorage; si no hay, usa prefers-color-scheme.
    ═══════════════════════════════════════ -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('geck-theme');
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>

    <meta name="google-site-verification" content="zQdCDQH6eJc4lniZPIcpINIApecX4D-fwU3IgfSA2YQ" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- ═══════════════════════════════════════
         TRANSICIONES DE PÁGINA — wipe circular (rima con el menú)
    ═══════════════════════════════════════ -->
    <ClientRouter />
    <style is:global>
      /* El círculo crece desde el punto del clic (--vt-x/--vt-y),
         con la misma curva que el reveal del menú. */
      @keyframes gc-page-reveal {
        from { clip-path: circle(0% at var(--vt-x, 50%) var(--vt-y, 50%)); }
        to   { clip-path: circle(150% at var(--vt-x, 50%) var(--vt-y, 50%)); }
      }
      /* La página saliente se queda quieta debajo; la entrante la cubre con el círculo. */
      ::view-transition-old(root) {
        animation: none;
        z-index: 0;
      }
      ::view-transition-new(root) {
        animation: gc-page-reveal 0.46s cubic-bezier(0.76, 0, 0.24, 1) both;
        z-index: 1;
      }
      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root),
        ::view-transition-new(root) { animation: none; }
      }
    </style>
    <script>
      // Origen del círculo = último punto de clic (fallback: centro).
      document.addEventListener('click', (e) => {
        const x = (e.clientX / window.innerWidth) * 100;
        const y = (e.clientY / window.innerHeight) * 100;
        document.documentElement.style.setProperty('--vt-x', x + '%');
        document.documentElement.style.setProperty('--vt-y', y + '%');
      }, true);

      // Durante la navegación, el reset de scroll debe ser INSTANTÁNEO.
      // Sin esto, `scroll-behavior: smooth` anima el regreso al tope cuando
      // vienes de una página scrolleada (p. ej. Contacto → Home) y la
      // transición se siente "eterna".
      document.addEventListener('astro:before-swap', () => {
        document.documentElement.style.scrollBehavior = 'auto';
      });

      // Reaplica el tema tras cada swap (el script no-flash solo corre en carga completa).
      document.addEventListener('astro:after-swap', () => {
        // Restaura el smooth-scroll una vez asentada la nueva página.
        requestAnimationFrame(() => {
          document.documentElement.style.scrollBehavior = '';
        });
        try {
          let t = localStorage.getItem('geck-theme');
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      });
    </script>

    <!-- ═══════════════════════════════════════
         TIPOGRAFÍA — Space Grotesk (títulos) + Inter (cuerpo)
    ═══════════════════════════════════════ -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Fuente no-bloqueante: se carga sin frenar el primer render (display=swap
        muestra texto al instante con la fuente de sistema y la cambia al cargar). */}
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      />
    </noscript>

    <!-- ═══════════════════════════════════════
         BÁSICO SEO
    ═══════════════════════════════════════ -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />}

    <!-- ═══════════════════════════════════════
         OPEN GRAPH (Facebook, WhatsApp, LinkedIn)
    ═══════════════════════════════════════ -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="es_MX" />

    <!-- ═══════════════════════════════════════
         TWITTER CARD
    ═══════════════════════════════════════ -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={twitterHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- ═══════════════════════════════════════
         FAVICON Y ICONOS
    ═══════════════════════════════════════ -->
    <link rel="icon" type="image/png" href="/assets/image/logo.png" />
    <link rel="apple-touch-icon" href="/assets/image/logo.png" />

    <!-- ═══════════════════════════════════════
         SCHEMA.ORG (Datos Estructurados)
    ═══════════════════════════════════════ -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Geck Codex",
        "url": "https://geckcodex.com",
        "logo": "https://geckcodex.com/assets/image/logo.png",
        "description": "Empresa de desarrollo web, apps móviles e inteligencia artificial en Parral, Chihuahua, México.",
        "foundingLocation": {
          "@type": "Place",
          "name": "Parral, Chihuahua, México"
        },
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+52-627-174-5436",
          "contactType": "customer service",
          "email": "ventas@geckcodex.com",
          "availableLanguage": ["Spanish", "English"]
        },
        "sameAs": [
          "https://www.instagram.com/geckcodex/",
          "https://github.com/geckcodex"
        ],
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Hidalgo del Parral",
          "addressRegion": "Chihuahua",
          "addressCountry": "MX"
        },
        "areaServed": {
          "@type": "Country",
          "name": "México"
        },
        "knowsAbout": [
          "Desarrollo Web",
          "Aplicaciones Móviles",
          "Inteligencia Artificial",
          "Computer Vision",
          "E-commerce",
          "SaaS",
          "UI/UX Design"
        ]
      }
    </script>

    <!-- ═══════════════════════════════════════
         PERFORMANCE
    ═══════════════════════════════════════ -->
    <link rel="dns-prefetch" href="https://cdn.simpleicons.org" />
  </head>
  <body>
    <Navbar client:load />
    
    <main>
      <slot />
    </main>
    
    <Footer client:visible />
  </body>
</html>