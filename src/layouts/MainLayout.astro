---
import { ClientRouter } from 'astro:transitions';
import Footer from '@/components/Footer.jsx';
import Navbar from '@/components/Navbar.jsx';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
}

const {
  title = 'Geck Codex | Desarrollo Web, Apps y AI desde México',
  description = 'Empresa de desarrollo web, apps móviles e inteligencia artificial en Parral, Chihuahua. Jóvenes mexicanos revolucionando la tecnología digital.',
  image = 'https://geckcodex.com/assets/image/og-image.jpg',
  canonical = Astro.url.href,
  noindex = false,
  type = 'website',
} = Astro.props;

const siteName = 'Geck Codex';
const twitterHandle = '@geckcodex';
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <!-- ═══════════════════════════════════════
         TEMA — no-flash (corre ANTES del CSS)
         Lee localStorage; si no hay, usa prefers-color-scheme.
    ═══════════════════════════════════════ -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('geck-theme');
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>

    <meta name="google-site-verification" content="zQdCDQH6eJc4lniZPIcpINIApecX4D-fwU3IgfSA2YQ" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- ═══════════════════════════════════════
         NAVEGACIÓN — ClientRouter sin animación de transición.
         Mantiene el SPA/prefetch (cambio de página rápido) pero el swap
         es instantáneo: sin wipe ni fade entre páginas.
    ═══════════════════════════════════════ -->
    <ClientRouter />
    <style is:global>
      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation: none;
      }
    </style>
    <script>
      // Durante la navegación, el reset de scroll debe ser INSTANTÁNEO.
      // Sin esto, `scroll-behavior: smooth` anima el regreso al tope cuando
      // vienes de una página scrolleada (p. ej. Contacto → Home) y la
      // transición se siente "eterna".
      document.addEventListener('astro:before-swap', () => {
        document.documentElement.style.scrollBehavior = 'auto';
      });

      // Reaplica el tema tras cada swap (el script no-flash solo corre en carga completa).
      document.addEventListener('astro:after-swap', () => {
        // Restaura el smooth-scroll una vez asentada la nueva página.
        requestAnimationFrame(() => {
          document.documentElement.style.scrollBehavior = '';
        });
        try {
          let t = localStorage.getItem('geck-theme');
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      });
    </script>

    <!-- ═══════════════════════════════════════
         TIPOGRAFÍA — Space Grotesk (títulos) + Inter (cuerpo)
    ═══════════════════════════════════════ -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Fuente no-bloqueante: se carga sin frenar el primer render (display=swap
        muestra texto al instante con la fuente de sistema y la cambia al cargar). */}
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      />
    </noscript>

    <!-- ═══════════════════════════════════════
         BÁSICO SEO
    ═══════════════════════════════════════ -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />}

    <!-- ═══════════════════════════════════════
         OPEN GRAPH (Facebook, WhatsApp, LinkedIn)
    ═══════════════════════════════════════ -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="es_MX" />

    <!-- ═══════════════════════════════════════
         TWITTER CARD
    ═══════════════════════════════════════ -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={twitterHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- ═══════════════════════════════════════
         FAVICON Y ICONOS
    ═══════════════════════════════════════ -->
    <link rel="icon" type="image/png" href="/assets/image/logo.png" />
    <link rel="apple-touch-icon" href="/assets/image/logo.png" />

    <!-- ═══════════════════════════════════════
         SCHEMA.ORG (Datos Estructurados)
    ═══════════════════════════════════════ -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Geck Codex",
        "url": "https://geckcodex.com",
        "logo": "https://geckcodex.com/assets/image/logo.png",
        "description": "Empresa de desarrollo web, apps móviles e inteligencia artificial en Parral, Chihuahua, México.",
        "foundingLocation": {
          "@type": "Place",
          "name": "Parral, Chihuahua, México"
        },
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+52-627-174-5436",
          "contactType": "customer service",
          "email": "ventas@geckcodex.com",
          "availableLanguage": ["Spanish", "English"]
        },
        "sameAs": [
          "https://www.instagram.com/geckcodex/",
          "https://github.com/geckcodex"
        ],
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Hidalgo del Parral",
          "addressRegion": "Chihuahua",
          "addressCountry": "MX"
        },
        "areaServed": {
          "@type": "Country",
          "name": "México"
        },
        "knowsAbout": [
          "Desarrollo Web",
          "Aplicaciones Móviles",
          "Inteligencia Artificial",
          "Computer Vision",
          "E-commerce",
          "SaaS",
          "UI/UX Design"
        ]
      }
    </script>

    <!-- ═══════════════════════════════════════
         PERFORMANCE
    ═══════════════════════════════════════ -->
    <link rel="dns-prefetch" href="https://cdn.simpleicons.org" />
  </head>
  <body>
    <!-- ═══════════════════════════════════════
         PRELOADER — carga inicial + transición de carga entre páginas.
         transition:persist mantiene el MISMO nodo entre navegaciones (no se
         recrea ni parpadea); el script lo muestra/oculta en cada cambio.
    ═══════════════════════════════════════ -->
    <div id="gc-preloader" class="gc-preloader" aria-hidden="true" transition:persist>
      <div class="gc-preloader__inner">
        <img src="/assets/image/logo.png" alt="" class="gc-preloader__logo" width="72" height="72" />
        <span class="gc-preloader__bar"><span class="gc-preloader__bar-fill"></span></span>
      </div>
    </div>
    <style is:global>
      .gc-preloader {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--background);
        transition: opacity 0.55s ease;
      }
      .gc-preloader.is-done { opacity: 0; pointer-events: none; }
      .gc-preloader__inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 22px;
      }
      .gc-preloader__logo {
        width: 72px;
        height: 72px;
        object-fit: contain;
        animation: gc-pl-pulse 1.6s ease-in-out infinite;
      }
      @keyframes gc-pl-pulse {
        0%, 100% { opacity: 0.5; transform: scale(0.95); }
        50%      { opacity: 1;   transform: scale(1); }
      }
      .gc-preloader__bar {
        width: 140px;
        height: 2px;
        border-radius: 2px;
        background: color-mix(in srgb, var(--accent) 20%, transparent);
        overflow: hidden;
      }
      .gc-preloader__bar-fill {
        display: block;
        height: 100%;
        width: 40%;
        border-radius: 2px;
        background: var(--accent);
        animation: gc-pl-slide 1.1s ease-in-out infinite;
      }
      @keyframes gc-pl-slide {
        0%   { transform: translateX(-120%); }
        100% { transform: translateX(320%); }
      }
      @media (prefers-reduced-motion: reduce) {
        .gc-preloader__logo,
        .gc-preloader__bar-fill { animation: none; }
        .gc-preloader { transition: none; }
      }
    </style>
    <script is:inline>
      // is:inline → corre durante el parseo y sus listeners sobre `document`
      // persisten entre navegaciones SPA (el preloader usa transition:persist,
      // así que es siempre el MISMO nodo).
      (function () {
        function pl() { return document.getElementById('gc-preloader'); }
        function show() { var el = pl(); if (el) el.classList.remove('is-done'); }
        function hide() { var el = pl(); if (el) el.classList.add('is-done'); }

        // ── Carga inicial: visible por defecto; ocultar cuando el DOM está listo
        //    (no esperamos a videos/imágenes pesadas, que cargan en 2.º plano).
        if (document.readyState !== 'loading') hide();
        else document.addEventListener('DOMContentLoaded', hide, { once: true });
        setTimeout(hide, 1500); // red de seguridad

        // ── Transición de carga entre páginas:
        //    mostrar al iniciar la navegación, ocultar cuando la nueva ya cargó.
        document.addEventListener('astro:before-preparation', show);
        document.addEventListener('astro:after-swap', function () {
          // La nueva página ya está en el DOM; breve pausa para que se vea la
          // transición de carga y se monte el contenido, luego revelar.
          requestAnimationFrame(function () { setTimeout(hide, 350); });
        });
      })();
    </script>

    <Navbar client:load />
    
    <main>
      <slot />
    </main>
    
    <Footer client:visible />
  </body>
</html>