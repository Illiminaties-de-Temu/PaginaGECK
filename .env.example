# ══════════════════════════════════════════════════════════════
#  Variables de entorno — copiar a `.env` y rellenar
#  Todas llevan prefijo PUBLIC_ porque Astro las inyecta en el
#  navegador (son identificadores públicos, no secretos).
# ══════════════════════════════════════════════════════════════

# ── Google Analytics 4 ────────────────────────────────────────
# Admin → Flujos de datos → ID de medición.
# Opcional: si se deja vacía, los builds de producción usan el ID por defecto
# fijado en `src/components/Analytics.astro` (G-NCC4TMJN98). Solo hace falta
# capturarla aquí para medir en una propiedad distinta.
PUBLIC_GA4_ID=

# ── Google Ads ────────────────────────────────────────────────
# Google Ads → Herramientas → Conversiones → Etiqueta de Google
# Formato: AW-1234567890
PUBLIC_GOOGLE_ADS_ID=

# Etiqueta de la acción de conversión "Contacto / Lead".
# En Google Ads → Conversiones → (tu acción) → Configurar etiqueta →
# aparece como send_to: 'AW-1234567890/AbC-D_efG-h12_34-567'
# Aquí va SOLO la parte después de la diagonal.
PUBLIC_ADS_CONVERSION_LABEL=

# ── Formulario de contacto (Web3Forms) ────────────────────────
# https://web3forms.com — Access Key gratuita ligada a ventas@geckcodex.com
PUBLIC_WEB3FORMS_KEY=
